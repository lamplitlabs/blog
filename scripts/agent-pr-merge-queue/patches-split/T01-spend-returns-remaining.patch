diff --git a/spend_remaining_test.go b/spend_remaining_test.go
new file mode 100644
index 0000000..9ac7be5
--- /dev/null
+++ b/spend_remaining_test.go
@@ -0,0 +1,115 @@
+package quota
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+)
+
+func TestSpendReturnsRemaining(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	rem, err := l.Spend("acme", 30)
+	if err != nil || rem != 70 {
+		t.Fatalf("Spend(30) = %d, %v; want 70, nil", rem, err)
+	}
+	rem, err = l.Spend("acme", 70)
+	if err != nil || rem != 0 {
+		t.Fatalf("Spend(70) = %d, %v; want 0, nil", rem, err)
+	}
+}
+
+func TestSpendOverBudgetReturnsUnchangedRemaining(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	if _, err := l.Spend("acme", 40); err != nil {
+		t.Fatal(err)
+	}
+	rem, err := l.Spend("acme", 61)
+	if !errors.Is(err, ErrOverBudget) || rem != 60 {
+		t.Fatalf("Spend(61) = %d, %v; want 60, ErrOverBudget", rem, err)
+	}
+}
+
+func TestSpendInvalidReturnsZero(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	if rem, err := l.Spend("acme", 0); err == nil || rem != 0 {
+		t.Fatalf("Spend(0) = %d, %v; want 0, error", rem, err)
+	}
+	if rem, err := l.Spend("globex", 1); err == nil || rem != 0 {
+		t.Fatalf("Spend unknown tenant = %d, %v; want 0, error", rem, err)
+	}
+}
+
+// Every successful concurrent spend must see a distinct remaining balance,
+// which only holds if the balance is read under the spend's own lock.
+func TestSpendRemainingConsistentUnderConcurrency(t *testing.T) {
+	const n = 100
+	l := NewLedger(map[string]int{"acme": n})
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	seen := map[int]bool{}
+	for range n {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			rem, err := l.Spend("acme", 1)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			mu.Lock()
+			seen[rem] = true
+			mu.Unlock()
+		}()
+	}
+	wg.Wait()
+	if len(seen) != n {
+		t.Fatalf("distinct remaining values = %d, want %d", len(seen), n)
+	}
+}
+
+func spendRemainingServer(limit int) *Server {
+	return &Server{
+		Ledger: NewLedger(map[string]int{"acme": limit}),
+		Log:    slog.New(slog.NewTextHandler(io.Discard, nil)),
+	}
+}
+
+// Concurrent handler requests must each report a distinct remaining value.
+func TestHandlerRemainingConsistentUnderConcurrency(t *testing.T) {
+	const n = 50
+	s := spendRemainingServer(n)
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	seen := map[int]bool{}
+	for range n {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			w := httptest.NewRecorder()
+			s.ServeHTTP(w, httptest.NewRequest(http.MethodPost, "/v1/spend",
+				strings.NewReader(`{"tenant":"acme","tokens":1}`)))
+			if w.Code != http.StatusOK {
+				t.Errorf("got %d %s", w.Code, w.Body)
+				return
+			}
+			var resp spendResponse
+			if err := json.Unmarshal(w.Body.Bytes(), &resp); err != nil {
+				t.Error(err)
+				return
+			}
+			mu.Lock()
+			seen[resp.Remaining] = true
+			mu.Unlock()
+		}()
+	}
+	wg.Wait()
+	if len(seen) != n {
+		t.Fatalf("distinct remaining values = %d, want %d", len(seen), n)
+	}
+}
