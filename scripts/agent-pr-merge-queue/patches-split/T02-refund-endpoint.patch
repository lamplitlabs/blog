index 0000000..85fd5a6
--- /dev/null
+++ b/refund.go
@@ -0,0 +1,45 @@
+package quota
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+)
+
+// Refund gives n tokens back to tenant, for example after the upstream model
+// call failed once the gateway had already charged the tenant. A refund never
+// takes the tenant's spend below zero: refunding more than was spent clears
+// the spend. An unknown tenant or a non-positive amount is an error.
+func (l *Ledger) Refund(tenant string, n int) error {
+	if n <= 0 {
+		return fmt.Errorf("refund %d tokens: must be positive", n)
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if _, ok := l.limit[tenant]; !ok {
+		return fmt.Errorf("tenant %q: unknown", tenant)
+	}
+	l.spent[tenant] = max(l.spent[tenant]-n, 0)
+	return nil
+}
+
+// handleRefund handles POST /v1/refund. It takes the same JSON body as
+// /v1/spend ({"tenant", "tokens"}) and answers {"remaining": N}.
+func (s *Server) handleRefund(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost {
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+	var req spendRequest
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 1<<16)).Decode(&req); err != nil {
+		http.Error(w, "bad request body", http.StatusBadRequest)
+		return
+	}
+	s.Log.Info("refund", "tenant", req.Tenant, "tokens", req.Tokens)
+	if err := s.Ledger.Refund(req.Tenant, req.Tokens); err != nil {
+		http.Error(w, "invalid refund", http.StatusBadRequest)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(spendResponse{Remaining: s.Ledger.Remaining(req.Tenant)})
+}
