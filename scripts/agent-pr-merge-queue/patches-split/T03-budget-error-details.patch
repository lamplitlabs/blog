@@ -0,0 +1,81 @@
+package quota
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestBudgetErrorFields(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	if err := l.Spend("acme", 60); err != nil {
+		t.Fatal(err)
+	}
+	err := l.Spend("acme", 41)
+	var be *BudgetError
+	if !errors.As(err, &be) {
+		t.Fatalf("err = %v, want *BudgetError", err)
+	}
+	want := BudgetError{Tenant: "acme", Spent: 60, Requested: 41, Limit: 100}
+	if *be != want {
+		t.Fatalf("got %+v, want %+v", *be, want)
+	}
+	if msg := be.Error(); !strings.Contains(msg, "over budget") || !strings.Contains(msg, `"acme"`) {
+		t.Fatalf("Error() = %q", msg)
+	}
+}
+
+func TestBudgetErrorOnlyForOverBudget(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	var be *BudgetError
+	for _, err := range []error{l.Spend("acme", 0), l.Spend("globex", 1)} {
+		if errors.As(err, &be) {
+			t.Fatalf("err = %v is a *BudgetError, want a plain error", err)
+		}
+	}
+}
+
+func budgetServer() *Server {
+	return &Server{
+		Ledger: NewLedger(map[string]int{"acme": 100}),
+		Log:    slog.New(slog.NewTextHandler(io.Discard, nil)),
+	}
+}
+
+func budgetPost(s *Server, body string) *httptest.ResponseRecorder {
+	w := httptest.NewRecorder()
+	s.ServeHTTP(w, httptest.NewRequest(http.MethodPost, "/v1/spend", strings.NewReader(body)))
+	return w
+}
+
+func TestHandlerOverBudgetJSON(t *testing.T) {
+	s := budgetServer()
+	if w := budgetPost(s, `{"tenant":"acme","tokens":30}`); w.Code != http.StatusOK {
+		t.Fatalf("first spend: got %d %s", w.Code, w.Body)
+	}
+	w := budgetPost(s, `{"tenant":"acme","tokens":71}`)
+	if w.Code != http.StatusPaymentRequired {
+		t.Fatalf("got %d, want 402", w.Code)
+	}
+	if ct := w.Header().Get("Content-Type"); ct != "application/json" {
+		t.Fatalf("Content-Type = %q, want application/json", ct)
+	}
+	var got map[string]any
+	if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+		t.Fatalf("body %q is not JSON: %v", w.Body, err)
+	}
+	want := map[string]any{"tenant": "acme", "spent": 30.0, "requested": 71.0, "limit": 100.0}
+	if len(got) != len(want) {
+		t.Fatalf("body = %v, want %v", got, want)
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Fatalf("body[%q] = %v, want %v (body %s)", k, got[k], v, w.Body)
+		}
+	}
+}
