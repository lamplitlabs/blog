@@ -0,0 +1,27 @@
+package quota
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+)
+
+// BudgetError is returned when a spend would take a tenant past its limit.
+// It carries the numbers a client needs to see how much budget is left.
+type BudgetError struct {
+	Tenant    string `json:"tenant"`
+	Spent     int    `json:"spent"`
+	Requested int    `json:"requested"`
+	Limit     int    `json:"limit"`
+}
+
+func (e *BudgetError) Error() string {
+	return fmt.Sprintf("tenant %q: over budget (%d + %d > %d)", e.Tenant, e.Spent, e.Requested, e.Limit)
+}
+
+// writeBudgetError writes e as a 402 JSON response.
+func writeBudgetError(w http.ResponseWriter, e *BudgetError) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusPaymentRequired)
+	_ = json.NewEncoder(w).Encode(e)
+}
diff --git a/budget_error_test.go b/budget_error_test.go
