@@ -0,0 +1,73 @@
+package quota
+
+import (
+	"io"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func newMaxTokensServer(maxTokens int) *Server {
+	return NewServerFromConfig(
+		Config{MaxTokens: maxTokens},
+		NewLedger(map[string]int{"acme": 100}),
+		slog.New(slog.NewTextHandler(io.Discard, nil)),
+	)
+}
+
+func postMaxTokens(s *Server, body string) *httptest.ResponseRecorder {
+	w := httptest.NewRecorder()
+	s.ServeHTTP(w, httptest.NewRequest(http.MethodPost, "/v1/spend", strings.NewReader(body)))
+	return w
+}
+
+func TestMaxTokensRejectsOversizedRequest(t *testing.T) {
+	s := newMaxTokensServer(10)
+	w := postMaxTokens(s, `{"tenant":"acme","tokens":11}`)
+	if w.Code != http.StatusRequestEntityTooLarge {
+		t.Fatalf("got %d, want 413", w.Code)
+	}
+	if got := s.Ledger.Remaining("acme"); got != 100 {
+		t.Fatalf("ledger touched: remaining %d, want 100", got)
+	}
+}
+
+func TestMaxTokensAllowsRequestAtCap(t *testing.T) {
+	s := newMaxTokensServer(10)
+	w := postMaxTokens(s, `{"tenant":"acme","tokens":10}`)
+	if w.Code != http.StatusOK || !strings.Contains(w.Body.String(), `"remaining":90`) {
+		t.Fatalf("got %d %s", w.Code, w.Body)
+	}
+}
+
+func TestMaxTokensZeroMeansNoCap(t *testing.T) {
+	s := newMaxTokensServer(0)
+	w := postMaxTokens(s, `{"tenant":"acme","tokens":100}`)
+	if w.Code != http.StatusOK || !strings.Contains(w.Body.String(), `"remaining":0`) {
+		t.Fatalf("got %d %s", w.Code, w.Body)
+	}
+}
+
+func TestMaxTokensCheckedBeforeBudget(t *testing.T) {
+	// Over both the cap and the budget: the cap wins, so the answer is 413, not 402.
+	s := newMaxTokensServer(50)
+	w := postMaxTokens(s, `{"tenant":"acme","tokens":101}`)
+	if w.Code != http.StatusRequestEntityTooLarge {
+		t.Fatalf("got %d, want 413", w.Code)
+	}
+}
+
+func TestNewServerFromConfigUsesLoadedMaxTokens(t *testing.T) {
+	cfg, err := LoadConfig(func(k string) string {
+		return map[string]string{"UPSTREAM_URL": "http://up.example/", "MAX_TOKENS": "7"}[k]
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := NewServerFromConfig(cfg, NewLedger(map[string]int{"acme": 100}), slog.New(slog.NewTextHandler(io.Discard, nil)))
+	if s.MaxTokens != 7 {
+		t.Fatalf("MaxTokens = %d, want 7", s.MaxTokens)
+	}
+}
