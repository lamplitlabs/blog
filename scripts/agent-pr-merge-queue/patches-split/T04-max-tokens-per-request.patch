--- /dev/null
+++ b/max_tokens.go
@@ -0,0 +1,15 @@
+package quota
+
+import "log/slog"
+
+// NewServerFromConfig returns a Server for ledger that logs to log and enforces
+// cfg.MaxTokens as the per-request cap.
+func NewServerFromConfig(cfg Config, ledger *Ledger, log *slog.Logger) *Server {
+	return &Server{Ledger: ledger, Log: log, MaxTokens: cfg.MaxTokens}
+}
+
+// overMaxTokens reports whether a single request for tokens exceeds the
+// configured per-request cap. A zero (or negative) cap means no cap.
+func (s *Server) overMaxTokens(tokens int) bool {
+	return s.MaxTokens > 0 && tokens > s.MaxTokens
+}
