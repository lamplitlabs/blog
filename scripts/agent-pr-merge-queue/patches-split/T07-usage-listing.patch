+package quota
+
+import (
+	"encoding/json"
+	"net/http"
+	"sort"
+	"strconv"
+)
+
+// UsageEntry is one tenant's spend against its limit.
+type UsageEntry struct {
+	Tenant string `json:"tenant"`
+	Spent  int    `json:"spent"`
+	Limit  int    `json:"limit"`
+}
+
+// Default paging for GET /v1/usage.
+const (
+	usageDefaultPage = 1
+	usageDefaultSize = 20
+)
+
+// Usage returns one entry per tenant, sorted by tenant id.
+func (l *Ledger) Usage() []UsageEntry {
+	l.mu.Lock()
+	out := make([]UsageEntry, 0, len(l.limit))
+	for t, lim := range l.limit {
+		out = append(out, UsageEntry{Tenant: t, Spent: l.spent[t], Limit: lim})
+	}
+	l.mu.Unlock()
+	sort.Slice(out, func(i, j int) bool { return out[i].Tenant < out[j].Tenant })
+	return out
+}
+
+// serveUsage handles GET /v1/usage?page=P&size=S. It reports whether the
+// request was for this route.
+func (s *Server) serveUsage(w http.ResponseWriter, r *http.Request) bool {
+	if r.URL.Path != "/v1/usage" {
+		return false
+	}
+	if r.Method != http.MethodGet {
+		w.Header().Set("Allow", http.MethodGet)
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return true
+	}
+	q := r.URL.Query()
+	page, ok := usageParam(q.Get("page"), usageDefaultPage)
+	if !ok {
+		http.Error(w, "bad page", http.StatusBadRequest)
+		return true
+	}
+	size, ok := usageParam(q.Get("size"), usageDefaultSize)
+	if !ok {
+		http.Error(w, "bad size", http.StatusBadRequest)
+		return true
+	}
+	items, err := Page(s.Ledger.Usage(), page, size)
+	if err != nil {
+		http.Error(w, "bad page or size", http.StatusBadRequest)
+		return true
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(items)
+	return true
+}
+
+// usageParam parses a positive integer query value, using def when empty.
+func usageParam(v string, def int) (int, bool) {
+	if v == "" {
+		return def, true
+	}
+	n, err := strconv.Atoi(v)
+	if err != nil || n < 1 {
+		return 0, false
+	}
+	return n, true
+}
