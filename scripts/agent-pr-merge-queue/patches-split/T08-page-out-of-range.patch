@@ -0,0 +1,7 @@
+package quota
+
+import "errors"
+
+// ErrPageOutOfRange is returned by Page when the requested page starts past
+// the end of the items. Page 1 of an empty list is a valid empty page.
+var ErrPageOutOfRange = errors.New("page out of range")
diff --git a/page_out_of_range_test.go b/page_out_of_range_test.go
new file mode 100644
index 0000000..2422844
--- /dev/null
+++ b/page_out_of_range_test.go
@@ -0,0 +1,60 @@
+package quota
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestPagePastEndIsOutOfRange(t *testing.T) {
+	items := []int{1, 2, 3, 4, 5, 6, 7}
+	cases := []struct{ page, size int }{
+		{4, 3},
+		{5, 3},
+		{2, 7},
+		{100, 1},
+	}
+	for _, c := range cases {
+		got, err := Page(items, c.page, c.size)
+		if !errors.Is(err, ErrPageOutOfRange) {
+			t.Errorf("Page(%d, %d) err = %v, want ErrPageOutOfRange", c.page, c.size, err)
+		}
+		if got != nil {
+			t.Errorf("Page(%d, %d) = %v, want nil", c.page, c.size, got)
+		}
+	}
+}
+
+func TestPageLastPartialPageIsInRange(t *testing.T) {
+	got, err := Page([]int{1, 2, 3, 4, 5, 6, 7}, 3, 3)
+	if err != nil {
+		t.Fatalf("Page(3, 3) err = %v", err)
+	}
+	if len(got) != 1 || got[0] != 7 {
+		t.Fatalf("Page(3, 3) = %v, want [7]", got)
+	}
+}
+
+func TestPageOneOfEmptyListIsEmptyPage(t *testing.T) {
+	got, err := Page([]int{}, 1, 3)
+	if err != nil {
+		t.Fatalf("Page of empty list, page 1: err = %v", err)
+	}
+	if got == nil || len(got) != 0 {
+		t.Fatalf("Page of empty list, page 1 = %#v, want empty non-nil slice", got)
+	}
+	if _, err := Page([]int(nil), 1, 3); err != nil {
+		t.Fatalf("Page of nil list, page 1: err = %v", err)
+	}
+}
+
+func TestPageTwoOfEmptyListIsOutOfRange(t *testing.T) {
+	if _, err := Page([]int{}, 2, 3); !errors.Is(err, ErrPageOutOfRange) {
+		t.Fatalf("Page of empty list, page 2: err = %v, want ErrPageOutOfRange", err)
+	}
+}
+
+func TestPageInvalidArgsAreNotOutOfRange(t *testing.T) {
+	if _, err := Page([]int{1}, 0, 3); err == nil || errors.Is(err, ErrPageOutOfRange) {
+		t.Fatalf("Page(0, 3) err = %v, want a non-range error", err)
+	}
+}
