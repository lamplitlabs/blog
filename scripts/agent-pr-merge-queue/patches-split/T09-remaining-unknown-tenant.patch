diff --git a/unknown_tenant.go b/unknown_tenant.go
new file mode 100644
index 0000000..1df73d9
--- /dev/null
+++ b/unknown_tenant.go
@@ -0,0 +1,6 @@
+package quota
+
+import "errors"
+
+// ErrUnknownTenant is returned when the ledger has no limit for a tenant.
+var ErrUnknownTenant = errors.New("unknown tenant")
diff --git a/unknown_tenant_test.go b/unknown_tenant_test.go
new file mode 100644
index 0000000..e91ff91
--- /dev/null
+++ b/unknown_tenant_test.go
@@ -0,0 +1,50 @@
+package quota
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestRemainingUnknownTenant(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	got, err := l.Remaining("globex")
+	if !errors.Is(err, ErrUnknownTenant) {
+		t.Fatalf("err = %v, want ErrUnknownTenant", err)
+	}
+	if got != 0 {
+		t.Fatalf("remaining = %d, want 0 alongside the error", got)
+	}
+}
+
+func TestRemainingKnownTenantFresh(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	got, err := l.Remaining("acme")
+	if err != nil {
+		t.Fatalf("known tenant: %v", err)
+	}
+	if got != 100 {
+		t.Fatalf("remaining = %d, want 100", got)
+	}
+}
+
+func TestRemainingExhaustedIsNotUnknown(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 10})
+	if err := l.Spend("acme", 10); err != nil {
+		t.Fatal(err)
+	}
+	got, err := l.Remaining("acme")
+	if err != nil {
+		t.Fatalf("exhausted tenant reported an error: %v", err)
+	}
+	if got != 0 {
+		t.Fatalf("remaining = %d, want 0", got)
+	}
+}
+
+func TestRemainingZeroLimitTenantIsKnown(t *testing.T) {
+	l := NewLedger(map[string]int{"free": 0})
+	got, err := l.Remaining("free")
+	if err != nil || got != 0 {
+		t.Fatalf("Remaining(free) = %d, %v; want 0, nil", got, err)
+	}
+}
