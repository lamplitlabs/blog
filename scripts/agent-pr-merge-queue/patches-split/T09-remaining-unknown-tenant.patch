@@ -46,11 +46,17 @@ func (l *Ledger) Spend(tenant string, n int) error {
 	return nil
 }
 
-// Remaining returns the tokens tenant may still spend.
-func (l *Ledger) Remaining(tenant string) int {
+// Remaining returns the tokens tenant may still spend. It returns an error
+// wrapping ErrUnknownTenant for a tenant the ledger has no limit for, so an
+// unknown tenant is not mistaken for an exhausted budget.
+func (l *Ledger) Remaining(tenant string) (int, error) {
 	l.mu.Lock()
 	defer l.mu.Unlock()
-	return l.limit[tenant] - l.spent[tenant]
+	lim, ok := l.limit[tenant]
+	if !ok {
+		return 0, fmt.Errorf("tenant %q: %w", tenant, ErrUnknownTenant)
+	}
+	return lim - l.spent[tenant], nil
 }
 
