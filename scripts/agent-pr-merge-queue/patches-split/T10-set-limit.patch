diff --git a/set_limit.go b/set_limit.go
new file mode 100644
index 0000000..a6ce8fb
--- /dev/null
+++ b/set_limit.go
@@ -0,0 +1,17 @@
+package quota
+
+import "fmt"
+
+// SetLimit sets tenant's limit to n, adding the tenant if it is not known yet.
+// n must be >= 0. Lowering the limit below what the tenant has already spent
+// is allowed: the spent tokens are kept, every later spend is refused and
+// Remaining reports 0.
+func (l *Ledger) SetLimit(tenant string, n int) error {
+	if n < 0 {
+		return fmt.Errorf("set limit %d for tenant %q: must not be negative", n, tenant)
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.limit[tenant] = n
+	return nil
+}
diff --git a/set_limit_test.go b/set_limit_test.go
new file mode 100644
index 0000000..8e7439d
--- /dev/null
+++ b/set_limit_test.go
@@ -0,0 +1,136 @@
+package quota
+
+import (
+	"errors"
+	"sync"
+	"testing"
+)
+
+func setLimitMustSpend(t *testing.T, l *Ledger, tenant string, n int) {
+	t.Helper()
+	if err := l.Spend(tenant, n); err != nil {
+		t.Fatalf("Spend(%q, %d): %v", tenant, n, err)
+	}
+}
+
+func TestSetLimitRaise(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	setLimitMustSpend(t, l, "acme", 100)
+	if err := l.SetLimit("acme", 150); err != nil {
+		t.Fatal(err)
+	}
+	if got := l.Remaining("acme"); got != 50 {
+		t.Fatalf("remaining = %d, want 50", got)
+	}
+	setLimitMustSpend(t, l, "acme", 50)
+	if err := l.Spend("acme", 1); !errors.Is(err, ErrOverBudget) {
+		t.Fatalf("err = %v, want ErrOverBudget", err)
+	}
+}
+
+func TestSetLimitLowerAboveSpent(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	setLimitMustSpend(t, l, "acme", 30)
+	if err := l.SetLimit("acme", 50); err != nil {
+		t.Fatal(err)
+	}
+	if got := l.Remaining("acme"); got != 20 {
+		t.Fatalf("remaining = %d, want 20", got)
+	}
+	if err := l.Spend("acme", 21); !errors.Is(err, ErrOverBudget) {
+		t.Fatalf("err = %v, want ErrOverBudget", err)
+	}
+	setLimitMustSpend(t, l, "acme", 20)
+}
+
+func TestSetLimitBelowSpent(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	setLimitMustSpend(t, l, "acme", 80)
+	if err := l.SetLimit("acme", 50); err != nil {
+		t.Fatalf("lowering below spent must be allowed: %v", err)
+	}
+	if got := l.Remaining("acme"); got != 0 {
+		t.Fatalf("remaining = %d, want 0 (never negative)", got)
+	}
+	if err := l.Spend("acme", 1); !errors.Is(err, ErrOverBudget) {
+		t.Fatalf("err = %v, want ErrOverBudget", err)
+	}
+	if got := l.Remaining("acme"); got != 0 {
+		t.Fatalf("remaining after refused spend = %d, want 0", got)
+	}
+	// Raising back above the spent amount re-opens the budget.
+	if err := l.SetLimit("acme", 90); err != nil {
+		t.Fatal(err)
+	}
+	if got := l.Remaining("acme"); got != 10 {
+		t.Fatalf("remaining = %d, want 10", got)
+	}
+}
+
+func TestSetLimitZero(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	if err := l.SetLimit("acme", 0); err != nil {
+		t.Fatal(err)
+	}
+	if got := l.Remaining("acme"); got != 0 {
+		t.Fatalf("remaining = %d, want 0", got)
+	}
+	if err := l.Spend("acme", 1); !errors.Is(err, ErrOverBudget) {
+		t.Fatalf("err = %v, want ErrOverBudget", err)
+	}
+}
+
+func TestSetLimitNewTenant(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	if err := l.Spend("globex", 1); err == nil {
+		t.Fatal("spend for unknown tenant succeeded")
+	}
+	if err := l.SetLimit("globex", 10); err != nil {
+		t.Fatal(err)
+	}
+	if got := l.Remaining("globex"); got != 10 {
+		t.Fatalf("remaining = %d, want 10", got)
+	}
+	setLimitMustSpend(t, l, "globex", 10)
+	if got := l.Remaining("acme"); got != 100 {
+		t.Fatalf("other tenant changed: remaining = %d, want 100", got)
+	}
+}
+
+func TestSetLimitRejectsNegative(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	if err := l.SetLimit("acme", -1); err == nil {
+		t.Fatal("SetLimit(-1) = nil, want an error")
+	}
+	if got := l.Remaining("acme"); got != 100 {
+		t.Fatalf("a refused SetLimit changed the limit: remaining = %d", got)
+	}
+	if err := l.SetLimit("newco", -5); err == nil {
+		t.Fatal("SetLimit(-5) for a new tenant = nil, want an error")
+	}
+	if err := l.Spend("newco", 1); err == nil {
+		t.Fatal("a refused SetLimit added the tenant")
+	}
+}
+
+func TestSetLimitConcurrentWithSpend(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 1000})
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 100; i++ {
+			_ = l.Spend("acme", 1)
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 100; i++ {
+			_ = l.SetLimit("acme", 1000-i)
+		}
+	}()
+	wg.Wait()
+	if got := l.Remaining("acme"); got < 0 {
+		t.Fatalf("remaining = %d, want >= 0", got)
+	}
+}
