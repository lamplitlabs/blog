+// Each successful concurrent spend must report a distinct balance, which is
+// only true if the balance is read under the same lock as the spend.
+func TestSpendRemainingIsConsistentUnderConcurrency(t *testing.T) {
+	const n = 100
+	l := NewLedger(map[string]int{"acme": n})
+	var wg sync.WaitGroup
+	results := make(chan int, n)
+	for range n {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			rem, err := l.Spend("acme", 1)
+			if err != nil {
+				t.Errorf("Spend: %v", err)
+				return
+			}
+			results <- rem
+		}()
+	}
+	wg.Wait()
+	close(results)
+	seen := make(map[int]bool, n)
+	for rem := range results {
+		if rem < 0 || rem >= n {
+			t.Fatalf("remaining %d out of range", rem)
+		}
+		if seen[rem] {
+			t.Fatalf("remaining %d reported twice", rem)
+		}
+		seen[rem] = true
+	}
+	if len(seen) != n {
+		t.Fatalf("got %d distinct balances, want %d", len(seen), n)
+	}
 }
 
