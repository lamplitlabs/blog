diff --git a/handler_test.go b/handler_test.go
index 0e302c1..737385a 100644
--- a/handler_test.go
+++ b/handler_test.go
@@ -42,3 +42,62 @@ func TestHandlerBadBody(t *testing.T) {
 		t.Fatalf("got %d, want 400", w.Code)
 	}
 }
+
+func postTo(s *Server, path, body string) *httptest.ResponseRecorder {
+	w := httptest.NewRecorder()
+	s.ServeHTTP(w, httptest.NewRequest(http.MethodPost, path, strings.NewReader(body)))
+	return w
+}
+
+func TestHandlerRefund(t *testing.T) {
+	s := newServer()
+	if w := postTo(s, "/v1/spend", `{"tenant":"acme","tokens":30}`); w.Code != http.StatusOK {
+		t.Fatalf("spend: got %d %s", w.Code, w.Body)
+	}
+	w := postTo(s, "/v1/refund", `{"tenant":"acme","tokens":20}`)
+	if w.Code != http.StatusOK || !strings.Contains(w.Body.String(), `"remaining":90`) {
+		t.Fatalf("refund: got %d %s", w.Code, w.Body)
+	}
+	if ct := w.Header().Get("Content-Type"); ct != "application/json" {
+		t.Fatalf("Content-Type = %q", ct)
+	}
+	// Spend still works after a refund.
+	w = postTo(s, "/v1/spend", `{"tenant":"acme","tokens":90}`)
+	if w.Code != http.StatusOK || !strings.Contains(w.Body.String(), `"remaining":0`) {
+		t.Fatalf("spend after refund: got %d %s", w.Code, w.Body)
+	}
+}
+
+func TestHandlerRefundErrors(t *testing.T) {
+	cases := []struct {
+		name string
+		body string
+		want int
+	}{
+		{"over refund", `{"tenant":"acme","tokens":1}`, http.StatusConflict},
+		{"zero", `{"tenant":"acme","tokens":0}`, http.StatusBadRequest},
+		{"negative", `{"tenant":"acme","tokens":-3}`, http.StatusBadRequest},
+		{"unknown tenant", `{"tenant":"globex","tokens":1}`, http.StatusBadRequest},
+		{"bad body", `{`, http.StatusBadRequest},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			s := newServer()
+			w := postTo(s, "/v1/refund", c.body)
+			if w.Code != c.want {
+				t.Fatalf("got %d, want %d (%s)", w.Code, c.want, w.Body)
+			}
+			if got := s.Ledger.Remaining("acme"); got != 100 {
+				t.Fatalf("remaining = %d, want 100", got)
+			}
+		})
+	}
+}
+
+func TestHandlerRefundMethodNotAllowed(t *testing.T) {
+	w := httptest.NewRecorder()
+	newServer().ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/v1/refund", nil))
+	if w.Code != http.StatusMethodNotAllowed {
+		t.Fatalf("got %d, want 405", w.Code)
+	}
+}
