 )
 
@@ -58,3 +59,77 @@ func TestSpendAll(t *testing.T) {
 		t.Fatalf("remaining = %d, want 500", got)
 	}
 }
+
+func TestRefund(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	if err := l.Spend("acme", 60); err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Refund("acme", 25); err != nil {
+		t.Fatal(err)
+	}
+	if got := l.Remaining("acme"); got != 65 {
+		t.Fatalf("remaining = %d, want 65", got)
+	}
+	if err := l.Refund("acme", 35); err != nil {
+		t.Fatalf("refund landing exactly on zero spend: %v", err)
+	}
+	if got := l.Remaining("acme"); got != 100 {
+		t.Fatalf("remaining = %d, want 100", got)
+	}
+}
+
+func TestRefundNeverBelowZero(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	if err := l.Refund("acme", 1); !errors.Is(err, ErrOverRefund) {
+		t.Fatalf("refund with nothing spent: err = %v, want ErrOverRefund", err)
+	}
+	if err := l.Spend("acme", 10); err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Refund("acme", 11); !errors.Is(err, ErrOverRefund) {
+		t.Fatalf("err = %v, want ErrOverRefund", err)
+	}
+	if got := l.Remaining("acme"); got != 90 {
+		t.Fatalf("a refused refund changed the balance: remaining = %d", got)
+	}
+}
+
+func TestRefundRejectsNonPositive(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	if err := l.Spend("acme", 50); err != nil {
+		t.Fatal(err)
+	}
+	for _, n := range []int{0, -5} {
+		if err := l.Refund("acme", n); err == nil {
+			t.Fatalf("Refund(%d) = nil, want an error", n)
+		}
+	}
+	if got := l.Remaining("acme"); got != 50 {
+		t.Fatalf("remaining = %d, want 50", got)
+	}
+}
+
+func TestRefundUnknownTenant(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 100})
+	if err := l.Refund("globex", 1); err == nil {
+		t.Fatal("unknown tenant accepted")
+	}
+}
+
+func TestRefundConcurrentWithSpend(t *testing.T) {
+	l := NewLedger(map[string]int{"acme": 1000})
+	if err := l.Spend("acme", 500); err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	for range 50 {
+		wg.Add(2)
+		go func() { defer wg.Done(); _ = l.Refund("acme", 10) }()
+		go func() { defer wg.Done(); _ = l.Spend("acme", 10) }()
+	}
+	wg.Wait()
+	if got := l.Remaining("acme"); got != 500 {
+		t.Fatalf("remaining = %d, want 500", got)
+	}
+}
