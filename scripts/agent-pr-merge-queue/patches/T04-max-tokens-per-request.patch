diff --git a/handler_test.go b/handler_test.go
index 0e302c1..32399d0 100644
--- a/handler_test.go
+++ b/handler_test.go
@@ -42,3 +42,42 @@ func TestHandlerBadBody(t *testing.T) {
 		t.Fatalf("got %d, want 400", w.Code)
 	}
 }
+
+func TestHandlerMaxTokensRejectsOverCap(t *testing.T) {
+	s := newServer()
+	s.MaxTokens = 50
+	w := post(s, `{"tenant":"acme","tokens":51}`)
+	if w.Code != http.StatusRequestEntityTooLarge {
+		t.Fatalf("got %d, want 413", w.Code)
+	}
+	if got := s.Ledger.Remaining("acme"); got != 100 {
+		t.Fatalf("ledger touched: remaining %d, want 100", got)
+	}
+}
+
+func TestHandlerMaxTokensAllowsAtCap(t *testing.T) {
+	s := newServer()
+	s.MaxTokens = 50
+	w := post(s, `{"tenant":"acme","tokens":50}`)
+	if w.Code != http.StatusOK || !strings.Contains(w.Body.String(), `"remaining":50`) {
+		t.Fatalf("got %d %s", w.Code, w.Body)
+	}
+}
+
+func TestHandlerMaxTokensZeroMeansNoCap(t *testing.T) {
+	s := newServer() // MaxTokens is zero
+	w := post(s, `{"tenant":"acme","tokens":100}`)
+	if w.Code != http.StatusOK || !strings.Contains(w.Body.String(), `"remaining":0`) {
+		t.Fatalf("got %d %s", w.Code, w.Body)
+	}
+}
+
+func TestHandlerMaxTokensCheckedBeforeBudget(t *testing.T) {
+	s := newServer()
+	s.MaxTokens = 50
+	// Over both the cap and the tenant budget: the cap answers first.
+	w := post(s, `{"tenant":"acme","tokens":500}`)
+	if w.Code != http.StatusRequestEntityTooLarge {
+		t.Fatalf("got %d, want 413", w.Code)
+	}
+}
