diff --git a/handler.go b/handler.go
index 2997f37..5ef36b2 100644
--- a/handler.go
+++ b/handler.go
@@ -22,8 +22,22 @@ type spendResponse struct {
 	Remaining int `json:"remaining"`
 }
 
-// ServeHTTP handles POST /v1/spend.
+type batchSpendRequest struct {
+	Tenant string `json:"tenant"`
+	Tokens []int  `json:"tokens"`
+}
+
+type batchSpendResponse struct {
+	Accepted  int `json:"accepted"`
+	Remaining int `json:"remaining"`
+}
+
+// ServeHTTP handles POST /v1/spend and POST /v1/spend/batch.
 func (s *Server) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	if r.URL.Path == "/v1/spend/batch" {
+		s.serveBatch(w, r)
+		return
+	}
 	if r.Method != http.MethodPost {
 		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
 		return
@@ -45,3 +59,34 @@ func (s *Server) ServeHTTP(w http.ResponseWriter, r *http.Request) {
 	w.Header().Set("Content-Type", "application/json")
 	_ = json.NewEncoder(w).Encode(spendResponse{Remaining: s.Ledger.Remaining(req.Tenant)})
 }
+
+// serveBatch handles POST /v1/spend/batch: it applies every spend in the body
+// with Ledger.SpendAll and reports how many were accepted.
+func (s *Server) serveBatch(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost {
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+	var req batchSpendRequest
+	if err := json.NewDecoder(http.MaxBytesReader(w, r.Body, 1<<16)).Decode(&req); err != nil {
+		http.Error(w, "bad request body", http.StatusBadRequest)
+		return
+	}
+	if len(req.Tokens) == 0 {
+		http.Error(w, "no spends in batch", http.StatusBadRequest)
+		return
+	}
+	for _, n := range req.Tokens {
+		if n <= 0 {
+			http.Error(w, "invalid spend", http.StatusBadRequest)
+			return
+		}
+	}
+	s.Log.Info("spend batch", "tenant", req.Tenant, "count", len(req.Tokens))
+	accepted := s.Ledger.SpendAll(req.Tenant, req.Tokens)
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(batchSpendResponse{
+		Accepted:  accepted,
+		Remaining: s.Ledger.Remaining(req.Tenant),
+	})
+}
diff --git a/handler_test.go b/handler_test.go
