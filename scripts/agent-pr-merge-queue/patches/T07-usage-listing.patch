index 01b580c..7da3468 100644
--- a/ledger.go
+++ b/ledger.go
@@ -5,6 +5,7 @@ package quota
 import (
 	"errors"
 	"fmt"
+	"sort"
 	"sync"
 )
 
@@ -72,3 +73,22 @@ func (l *Ledger) SpendAll(tenant string, spends []int) int {
 	wg.Wait()
 	return ok
 }
+
+// UsageEntry is one tenant's spend against its limit.
+type UsageEntry struct {
+	Tenant string `json:"tenant"`
+	Spent  int    `json:"spent"`
+	Limit  int    `json:"limit"`
+}
+
+// Usage returns one entry per known tenant, sorted by tenant id.
+func (l *Ledger) Usage() []UsageEntry {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	out := make([]UsageEntry, 0, len(l.limit))
+	for t, lim := range l.limit {
+		out = append(out, UsageEntry{Tenant: t, Spent: l.spent[t], Limit: lim})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Tenant < out[j].Tenant })
+	return out
+}
