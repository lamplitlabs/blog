 }
+
+func getUsage(s *Server, query string) *httptest.ResponseRecorder {
+	w := httptest.NewRecorder()
+	s.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/v1/usage"+query, nil))
+	return w
+}
+
+func usageServer(n int) *Server {
+	limits := map[string]int{}
+	for i := 0; i < n; i++ {
+		limits[fmt.Sprintf("t%02d", i)] = 100 + i
+	}
+	return &Server{
+		Ledger: NewLedger(limits),
+		Log:    slog.New(slog.NewTextHandler(io.Discard, nil)),
+	}
+}
+
+func decodeUsage(t *testing.T, w *httptest.ResponseRecorder) []UsageEntry {
+	t.Helper()
+	if w.Code != http.StatusOK {
+		t.Fatalf("got %d %s, want 200", w.Code, w.Body)
+	}
+	if ct := w.Header().Get("Content-Type"); ct != "application/json" {
+		t.Fatalf("Content-Type = %q", ct)
+	}
+	var got []UsageEntry
+	if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+		t.Fatalf("decode %s: %v", w.Body, err)
+	}
+	return got
+}
+
+func TestHandlerUsage(t *testing.T) {
+	s := newServer()
+	if w := post(s, `{"tenant":"acme","tokens":30}`); w.Code != http.StatusOK {
+		t.Fatalf("spend: %d %s", w.Code, w.Body)
+	}
+	got := decodeUsage(t, getUsage(s, ""))
+	want := []UsageEntry{{Tenant: "acme", Spent: 30, Limit: 100}}
+	if len(got) != 1 || got[0] != want[0] {
+		t.Fatalf("usage = %v, want %v", got, want)
+	}
+}
+
+func TestHandlerUsageDefaultsToPage1Size20(t *testing.T) {
+	got := decodeUsage(t, getUsage(usageServer(25), ""))
+	if len(got) != 20 || got[0].Tenant != "t00" || got[19].Tenant != "t19" {
+		t.Fatalf("default page = %v", got)
+	}
+}
+
+func TestHandlerUsagePaging(t *testing.T) {
+	s := usageServer(5)
+	got := decodeUsage(t, getUsage(s, "?page=2&size=2"))
+	if len(got) != 2 || got[0].Tenant != "t02" || got[1].Tenant != "t03" || got[1].Limit != 103 {
+		t.Fatalf("page 2 size 2 = %v", got)
+	}
+	got = decodeUsage(t, getUsage(s, "?page=3&size=2"))
+	if len(got) != 1 || got[0].Tenant != "t04" {
+		t.Fatalf("page 3 size 2 = %v", got)
+	}
+}
+
+func TestHandlerUsagePastEnd(t *testing.T) {
+	w := getUsage(usageServer(3), "?page=9&size=2")
+	if got := decodeUsage(t, w); len(got) != 0 {
+		t.Fatalf("past the end = %v, want empty", got)
+	}
+	if body := strings.TrimSpace(w.Body.String()); body != "[]" {
+		t.Fatalf("body = %q, want []", body)
+	}
+}
+
+func TestHandlerUsageBadParams(t *testing.T) {
+	for _, q := range []string{"?page=0", "?size=0", "?page=-1", "?page=x", "?size=1.5"} {
+		if w := getUsage(usageServer(3), q); w.Code != http.StatusBadRequest {
+			t.Errorf("%s: got %d, want 400", q, w.Code)
+		}
+	}
+}
+
+func TestHandlerUsageMethodNotAllowed(t *testing.T) {
+	w := httptest.NewRecorder()
+	newServer().ServeHTTP(w, httptest.NewRequest(http.MethodPost, "/v1/usage", nil))
+	if w.Code != http.StatusMethodNotAllowed {
+		t.Fatalf("got %d, want 405", w.Code)
+	}
+}
