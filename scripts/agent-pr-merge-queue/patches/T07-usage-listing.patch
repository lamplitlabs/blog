diff --git a/page.go b/page.go
index 43ca0f0..b6708e3 100644
--- a/page.go
+++ b/page.go
@@ -8,13 +8,18 @@ func Page[T any](items []T, page, size int) ([]T, error) {
 	if page < 1 || size < 1 {
 		return nil, fmt.Errorf("page %d size %d: both must be >= 1", page, size)
 	}
-	start := (page - 1) * size
-	if start >= len(items) {
+	// Compare before multiplying so huge page/size values cannot overflow.
+	pages := len(items) / size
+	if len(items)%size != 0 {
+		pages++
+	}
+	if page > pages {
 		return []T{}, nil
 	}
-	end := start + size
-	if end > len(items) {
-		end = len(items)
+	start := (page - 1) * size
+	end := len(items)
+	if size < end-start {
+		end = start + size
 	}
 	return items[start:end], nil
 }
diff --git a/page_test.go b/page_test.go
index 48dc450..f82116d 100644
--- a/page_test.go
+++ b/page_test.go
@@ -1,6 +1,7 @@
 package quota
 
 import (
+	"math"
 	"reflect"
 	"testing"
 )
@@ -32,3 +33,24 @@ func TestPageRejectsZero(t *testing.T) {
 		t.Fatal("page 0 accepted")
 	}
 }
+
+func TestPageHugeValuesDoNotOverflow(t *testing.T) {
+	items := []int{1, 2, 3}
+	for _, c := range []struct{ page, size int }{
+		{math.MaxInt, 2},
+		{2, math.MaxInt},
+		{math.MaxInt / 2, 4},
+	} {
+		got, err := Page(items, c.page, c.size)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(got) != 0 {
+			t.Errorf("Page(%d, %d) = %v, want empty", c.page, c.size, got)
+		}
+	}
+	got, err := Page(items, 1, math.MaxInt)
+	if err != nil || !reflect.DeepEqual(got, items) {
+		t.Fatalf("Page(1, MaxInt) = %v, %v; want all items", got, err)
+	}
+}
