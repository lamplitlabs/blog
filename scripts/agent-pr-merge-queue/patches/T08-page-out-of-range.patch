+func TestPagePastEndIsOutOfRange(t *testing.T) {
+	items := []int{1, 2, 3, 4, 5, 6, 7}
+	cases := []struct{ page, size int }{
+		{4, 3},
+		{5, 3},
+		{2, 7},
+	}
+	for _, c := range cases {
+		got, err := Page(items, c.page, c.size)
+		if !errors.Is(err, ErrPageOutOfRange) {
+			t.Errorf("Page(%d, %d) err = %v, want ErrPageOutOfRange", c.page, c.size, err)
+		}
+		if got != nil {
+			t.Errorf("Page(%d, %d) = %v, want nil", c.page, c.size, got)
+		}
+	}
+	if _, err := Page([]int{}, 2, 3); !errors.Is(err, ErrPageOutOfRange) {
+		t.Errorf("Page(empty, 2, 3) err = %v, want ErrPageOutOfRange", err)
+	}
+}
+
+func TestPageFirstOfEmptyIsEmpty(t *testing.T) {
+	for _, items := range [][]int{nil, {}} {
+		got, err := Page(items, 1, 3)
+		if err != nil {
+			t.Fatalf("Page(%v, 1, 3) err = %v", items, err)
+		}
+		if got == nil || len(got) != 0 {
+			t.Errorf("Page(%v, 1, 3) = %#v, want empty non-nil slice", items, got)
+		}
+	}
+}
+
 func TestPageRejectsZero(t *testing.T) {
 	if _, err := Page([]int{1}, 0, 3); err == nil {
 		t.Fatal("page 0 accepted")
 	}
+	if _, err := Page([]int{1}, 1, 0); err == nil {
+		t.Fatal("size 0 accepted")
+	}
+	if _, err := Page([]int{1}, 0, 3); errors.Is(err, ErrPageOutOfRange) {
+		t.Fatal("page 0 reported as out of range, want invalid argument")
+	}
 }
