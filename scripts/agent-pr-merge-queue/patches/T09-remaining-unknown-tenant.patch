diff --git a/ledger.go b/ledger.go
index 01b580c..7fb7ebd 100644
--- a/ledger.go
+++ b/ledger.go
@@ -11,6 +11,9 @@ import (
 // ErrOverBudget is returned when a spend would take a tenant past its limit.
 var ErrOverBudget = errors.New("over budget")
 
+// ErrUnknownTenant is returned for a tenant the ledger has no limit for.
+var ErrUnknownTenant = errors.New("unknown tenant")
+
 // Ledger tracks tokens spent per tenant against a per-tenant limit.
 type Ledger struct {
 	mu    sync.Mutex
@@ -37,7 +40,7 @@ func (l *Ledger) Spend(tenant string, n int) error {
 	defer l.mu.Unlock()
 	lim, ok := l.limit[tenant]
 	if !ok {
-		return fmt.Errorf("tenant %q: unknown", tenant)
+		return fmt.Errorf("tenant %q: %w", tenant, ErrUnknownTenant)
 	}
 	if l.spent[tenant]+n > lim {
 		return fmt.Errorf("tenant %q: %w (%d + %d > %d)", tenant, ErrOverBudget, l.spent[tenant], n, lim)
@@ -46,11 +49,17 @@ func (l *Ledger) Spend(tenant string, n int) error {
 	return nil
 }
 
-// Remaining returns the tokens tenant may still spend.
-func (l *Ledger) Remaining(tenant string) int {
+// Remaining returns the tokens tenant may still spend. An unknown tenant
+// yields an error wrapping ErrUnknownTenant, so it cannot be mistaken for an
+// exhausted budget.
+func (l *Ledger) Remaining(tenant string) (int, error) {
 	l.mu.Lock()
 	defer l.mu.Unlock()
-	return l.limit[tenant] - l.spent[tenant]
+	lim, ok := l.limit[tenant]
+	if !ok {
+		return 0, fmt.Errorf("tenant %q: %w", tenant, ErrUnknownTenant)
+	}
+	return lim - l.spent[tenant], nil
 }
 
 // SpendAll applies the spends concurrently and returns how many succeeded.
