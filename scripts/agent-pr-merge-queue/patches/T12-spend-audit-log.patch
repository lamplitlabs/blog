+// audit writes the one Info-level audit line for a spend decision. outcome is
+// "ok", "over_budget" or "invalid"; extra carries outcome-specific attributes
+// such as "remaining" for an accepted spend.
+func (s *Server) audit(r *http.Request, req spendRequest, outcome string, extra ...slog.Attr) {
+	attrs := append([]slog.Attr{
+		slog.String("tenant", req.Tenant),
+		slog.Int("tokens", req.Tokens),
+		slog.String("outcome", outcome),
+	}, extra...)
+	s.Log.LogAttrs(r.Context(), slog.LevelInfo, "spend", attrs...)
 }
