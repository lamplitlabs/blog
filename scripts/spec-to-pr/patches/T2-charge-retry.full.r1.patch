 def charge(client: PaymentClient, invoice_id: str, amount: Decimal, idempotency_key: str) -> str:
     return client.charge(invoice_id, amount, idempotency_key)
+
+
+INITIAL_BACKOFF_SECONDS = 0.5
+MAX_RETRY_AFTER_SECONDS = 30.0
+
+
+def _retry_delay(error: TransientError, failed_attempts: int) -> float:
+    """Seconds to wait after `failed_attempts` failures (1-based) before the next try."""
+    if error.retry_after is not None:
+        return min(max(float(error.retry_after), 0.0), MAX_RETRY_AFTER_SECONDS)
+    return INITIAL_BACKOFF_SECONDS * (2 ** (failed_attempts - 1))
+
+
+def charge_with_retry(
+    client: PaymentClient,
+    invoice_id: str,
+    amount: Decimal,
+    idempotency_key: str,
+    max_attempts: int = 3,
+    sleep: Callable[[float], None] = time.sleep,
+) -> str:
+    """Charge with retries on TransientError, reusing the same idempotency key.
+
+    CardDeclined and any other exception propagate after the first call.
+    When every attempt fails, the last TransientError is re-raised.
+    """
+    if max_attempts < 1:
+        raise InvoicingError(f"max_attempts must be at least 1, got {max_attempts}")
+    attempt = 1
+    while True:
+        try:
+            return client.charge(invoice_id, amount, idempotency_key)
+        except TransientError as error:
+            if attempt >= max_attempts:
+                raise
+            sleep(_retry_delay(error, attempt))
+            attempt += 1
diff --git a/tests/test_charge_with_retry.py b/tests/test_charge_with_retry.py
