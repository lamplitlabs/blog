+"""CSV export of invoices for finance."""
+import csv
+import io
+from typing import Iterable
+
+from .models import Invoice
+from .money import fmt
+
+HEADER = ("id", "customer", "issued", "subtotal", "tax", "total")
+
+# A cell starting with one of these is read as a formula by spreadsheets.
+_FORMULA_PREFIXES = ("=", "+", "-", "@")
+
+
+def _safe_text(value: str) -> str:
+    """Neutralise spreadsheet formula injection with a leading apostrophe."""
+    if value.startswith(_FORMULA_PREFIXES):
+        return "'" + value
+    return value
+
+
+def export_csv(invoices: Iterable[Invoice]) -> str:
+    """Return the invoices as CSV text, sorted by issued date then id.
+
+    Lines end with "\\n"; with no invoices only the header line is returned.
+    """
+    buf = io.StringIO()
+    writer = csv.writer(buf, lineterminator="\n")
+    writer.writerow(HEADER)
+    for inv in sorted(invoices, key=lambda i: (i.issued, i.id)):
+        writer.writerow((
+            inv.id,
+            _safe_text(inv.customer),
+            inv.issued.isoformat(),
+            fmt(inv.subtotal()),
+            fmt(inv.tax()),
+            fmt(inv.total()),
+        ))
+    return buf.getvalue()
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
