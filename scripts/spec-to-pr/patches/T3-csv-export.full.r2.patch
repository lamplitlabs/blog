+"""CSV export of invoices for finance."""
+import csv
+import io
+from typing import Iterable
+
+from .models import Invoice
+from .money import fmt
+
+HEADER = ("id", "customer", "issued", "subtotal", "tax", "total")
+
+# Leading characters a spreadsheet would treat as the start of a formula.
+_FORMULA_PREFIXES = ("=", "+", "-", "@")
+
+
+def _safe_customer(customer: str) -> str:
+    """Neutralise spreadsheet formula injection with a leading apostrophe."""
+    if customer.startswith(_FORMULA_PREFIXES):
+        return "'" + customer
+    return customer
+
+
+def export_csv(invoices: Iterable[Invoice]) -> str:
+    """Return invoices as CSV text, sorted by issued date then id.
+
+    Columns: id,customer,issued,subtotal,tax,total. Lines end with "\\n".
+    """
+    out = io.StringIO()
+    writer = csv.writer(out, lineterminator="\n")
+    writer.writerow(HEADER)
+    for inv in sorted(invoices, key=lambda i: (i.issued, i.id)):
+        writer.writerow((
+            inv.id,
+            _safe_customer(inv.customer),
+            inv.issued.isoformat(),
+            fmt(inv.subtotal()),
+            fmt(inv.tax()),
+            fmt(inv.total()),
+        ))
+    return out.getvalue()
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
