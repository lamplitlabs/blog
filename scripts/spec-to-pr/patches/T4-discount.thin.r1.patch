+"""Percentage discounts on invoices (T4).
+
+A discount is applied to the invoice before tax: it reduces the subtotal by
+``percent`` per cent and the tax by the same proportion, so the tax is what it
+would be on the discounted line amounts. The invoice itself is not changed.
+"""
+from dataclasses import dataclass
+from decimal import Decimal, InvalidOperation
+
+from .errors import InvoicingError
+from .models import Invoice
+from .money import to_money
+
+HUNDRED = Decimal("100")
+
+
+class InvalidDiscount(InvoicingError):
+    """The discount percentage is not a number from 0 to 100."""
+
+
+@dataclass(frozen=True)
+class DiscountedInvoice:
+    invoice: Invoice
+    percent: Decimal
+    subtotal: Decimal  # before discount
+    discount: Decimal  # amount taken off the subtotal
+    tax: Decimal  # tax after discount
+    total: Decimal  # subtotal - discount + tax
+
+    @property
+    def net(self) -> Decimal:
+        """Subtotal after the discount, before tax."""
+        return to_money(self.subtotal - self.discount)
+
+
+def _parse_percent(percent) -> Decimal:
+    # Floats and bools are refused: money code stays in Decimal.
+    if isinstance(percent, (bool, float)) or not isinstance(percent, (int, str, Decimal)):
+        raise InvalidDiscount(f"discount percent must be a Decimal, int or str, not {type(percent).__name__}")
+    try:
+        value = Decimal(percent)
+    except InvalidOperation:
+        raise InvalidDiscount(f"discount percent is not a number: {percent!r}") from None
+    if not value.is_finite() or value < 0 or value > HUNDRED:
+        raise InvalidDiscount(f"discount percent must be between 0 and 100, got {percent}")
+    return value
+
+
+def apply_discount(invoice: Invoice, percent) -> DiscountedInvoice:
+    """Apply a ``percent`` % discount (0..100) to ``invoice`` before tax.
+
+    Returns the discounted amounts, each rounded half-up to cents; the
+    invoice is not modified. Raises InvalidDiscount for a bad percentage.
+    """
+    pct = _parse_percent(percent)
+    rate = pct / HUNDRED
+    subtotal = invoice.subtotal()
+    discount = to_money(subtotal * rate)
+    tax = to_money(invoice.tax() * (1 - rate))
+    total = to_money(subtotal - discount + tax)
+    return DiscountedInvoice(invoice, pct, subtotal, discount, tax, total)
diff --git a/tests/test_discounts.py b/tests/test_discounts.py
