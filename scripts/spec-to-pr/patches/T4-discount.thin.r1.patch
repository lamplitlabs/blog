@@ -0,0 +1,69 @@
+import unittest
+from datetime import date
+from decimal import Decimal
+
+from invoicing.discounts import InvalidDiscount, apply_discount
+from invoicing.errors import InvoicingError
+from invoicing.models import Invoice, LineItem
+
+
+def make_invoice():
+    return Invoice("INV-1", "Acme", date(2026, 1, 15), [
+        LineItem("A", "Widget", 2, Decimal("10.00"), Decimal("0.20")),
+        LineItem("B", "Gadget", 1, Decimal("5.55"), Decimal("0.20")),
+    ])
+
+
+class ApplyDiscountTest(unittest.TestCase):
+    def test_ten_percent(self):
+        # subtotal 25.55, tax 5.11
+        d = apply_discount(make_invoice(), Decimal("10"))
+        self.assertEqual(d.subtotal, Decimal("25.55"))
+        self.assertEqual(d.discount, Decimal("2.56"))  # 2.555 rounds half-up
+        self.assertEqual(d.net, Decimal("22.99"))
+        self.assertEqual(d.tax, Decimal("4.60"))  # 4.599
+        self.assertEqual(d.total, Decimal("27.59"))
+        self.assertEqual(d.percent, Decimal("10"))
+
+    def test_zero_percent_keeps_totals(self):
+        inv = make_invoice()
+        d = apply_discount(inv, 0)
+        self.assertEqual(d.discount, Decimal("0.00"))
+        self.assertEqual(d.tax, inv.tax())
+        self.assertEqual(d.total, inv.total())
+
+    def test_hundred_percent_is_free(self):
+        d = apply_discount(make_invoice(), 100)
+        self.assertEqual(d.discount, Decimal("25.55"))
+        self.assertEqual(d.tax, Decimal("0.00"))
+        self.assertEqual(d.total, Decimal("0.00"))
+
+    def test_fractional_percent_as_string(self):
+        d = apply_discount(make_invoice(), "12.5")
+        self.assertEqual(d.discount, Decimal("3.19"))  # 3.19375
+        self.assertEqual(d.tax, Decimal("4.47"))  # 4.47125
+        self.assertEqual(d.total, Decimal("26.83"))
+
+    def test_does_not_modify_invoice(self):
+        inv = make_invoice()
+        apply_discount(inv, 50)
+        self.assertEqual(inv.total(), Decimal("30.66"))
+        self.assertEqual(len(inv.lines), 2)
+
+    def test_empty_invoice(self):
+        d = apply_discount(Invoice("INV-2", "Acme", date(2026, 1, 15)), 25)
+        self.assertEqual(d.total, Decimal("0.00"))
+
+    def test_invalid_percent_rejected(self):
+        for bad in (Decimal("-1"), 101, "abc", "NaN", "Infinity", 10.0, True, None):
+            with self.subTest(bad=bad):
+                with self.assertRaises(InvalidDiscount):
+                    apply_discount(make_invoice(), bad)
+
+    def test_error_is_domain_error(self):
+        self.assertTrue(issubclass(InvalidDiscount, InvoicingError))
+        self.assertTrue(issubclass(InvalidDiscount, ValueError))
+
+
+if __name__ == "__main__":
+    unittest.main()
