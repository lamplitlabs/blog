diff --git a/invoicing/logs.py b/invoicing/logs.py
index dfba159..c743ba7 100644
--- a/invoicing/logs.py
+++ b/invoicing/logs.py
@@ -1,8 +1,42 @@
 from datetime import datetime, timezone
 
+from invoicing.errors import InvoicingError
+from invoicing.money import fmt
+
+MIN_CARD_DIGITS = 12
+
 
 def log_line(event: str, **fields) -> str:
     """Format one structured log line: `<ts> <event> k=v k=v`."""
     ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
     parts = [ts, event] + [f"{k}={v}" for k, v in sorted(fields.items())]
     return " ".join(parts)
+
+
+def _mask_card(card_number: str) -> str:
+    """Return `****` plus the last 4 digits; never the full number."""
+    digits = str(card_number).replace(" ", "").replace("-", "")
+    if not digits.isascii() or not digits.isdigit():
+        raise InvoicingError("card number must contain only digits, spaces or dashes")
+    if len(digits) < MIN_CARD_DIGITS:
+        raise InvoicingError(f"card number must have at least {MIN_CARD_DIGITS} digits")
+    return "****" + digits[-4:]
+
+
+def _email_domain(email: str) -> str:
+    """Return the part after the last `@`; never the address itself."""
+    _, at, domain = str(email).strip().rpartition("@")
+    if not at or not domain:
+        raise InvoicingError("email address must contain a domain after '@'")
+    return domain
+
+
+def log_charge(invoice_id, amount, card_number, email) -> str:
+    """Log a card charge without the full card number or the email address."""
+    return log_line(
+        "charge",
+        invoice=invoice_id,
+        amount=fmt(amount),
+        card=_mask_card(card_number),
+        email_domain=_email_domain(email),
+    )
diff --git a/tests/test_log_charge.py b/tests/test_log_charge.py
new file mode 100644
index 0000000..c675fa2
--- /dev/null
+++ b/tests/test_log_charge.py
@@ -0,0 +1,52 @@
+import unittest
+from decimal import Decimal
+
+from invoicing.errors import InvoicingError
+from invoicing.logs import log_charge
+
+
+class LogChargeTest(unittest.TestCase):
+    def test_line_fields(self):
+        line = log_charge("INV-1", Decimal("9.9"), "4242424242424242", "jane@example.com")
+        self.assertTrue(line.endswith(
+            " charge amount=9.90 card=****4242 email_domain=example.com invoice=INV-1"
+        ), line)
+
+    def test_amount_rounded_half_up(self):
+        line = log_charge("INV-2", Decimal("1.005"), "4242424242424242", "a@b.io")
+        self.assertIn(" amount=1.01 ", line)
+
+    def test_never_logs_full_card_or_email(self):
+        line = log_charge("INV-1", Decimal("5"), "4111 1111 1111 1234", "jane.doe@example.com")
+        self.assertNotIn("4111111111111234", line)
+        self.assertNotIn("4111 1111 1111 1234", line)
+        self.assertNotIn("jane.doe", line)
+        self.assertNotIn("@", line)
+
+    def test_strips_spaces_and_dashes(self):
+        self.assertIn("card=****9876", log_charge("I", Decimal("1"), "4000 1234 5678 9876", "x@y.z"))
+        self.assertIn("card=****9876", log_charge("I", Decimal("1"), "4000-1234-5678-9876", "x@y.z"))
+
+    def test_exactly_twelve_digits_ok(self):
+        self.assertIn("card=****9012", log_charge("I", Decimal("1"), "1234-5678-9012", "x@y.z"))
+
+    def test_too_few_digits_raises(self):
+        with self.assertRaises(InvoicingError):
+            log_charge("I", Decimal("1"), "1234 5678 901", "x@y.z")
+
+    def test_non_digit_card_raises(self):
+        with self.assertRaises(InvoicingError):
+            log_charge("I", Decimal("1"), "4242x42424242424", "x@y.z")
+
+    def test_email_without_domain_raises(self):
+        for email in ("jane.example.com", "jane@"):
+            with self.assertRaises(InvoicingError):
+                log_charge("I", Decimal("1"), "4242424242424242", email)
+
+    def test_domain_after_last_at(self):
+        line = log_charge("I", Decimal("1"), "4242424242424242", '"a@b"@example.org')
+        self.assertIn("email_domain=example.org", line)
+
+
+if __name__ == "__main__":
+    unittest.main()
