diff --git a/invoicing/logs.py b/invoicing/logs.py
index dfba159..06e6e15 100644
--- a/invoicing/logs.py
+++ b/invoicing/logs.py
@@ -1,8 +1,47 @@
 from datetime import datetime, timezone
 
+from invoicing.money import fmt
+
 
 def log_line(event: str, **fields) -> str:
     """Format one structured log line: `<ts> <event> k=v k=v`."""
     ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
     parts = [ts, event] + [f"{k}={v}" for k, v in sorted(fields.items())]
     return " ".join(parts)
+
+
+def _mask_card(card_number) -> str:
+    """Keep only the last four digits of a card number (PCI DSS display rule)."""
+    digits = "".join(ch for ch in str(card_number) if ch.isdigit())
+    if len(digits) < 4:
+        return "****"
+    return "****" + digits[-4:]
+
+
+def _mask_email(email) -> str:
+    """Hide the local part of an email, keeping its first character and the domain."""
+    text = str(email)
+    local, sep, domain = text.rpartition("@")
+    if not sep or not local or not domain:
+        return "***"
+    return f"{_clean(local[0])}***@{_clean(domain)}"
+
+
+def _clean(value) -> str:
+    """Make a value safe for a single `k=v` field: no whitespace or control characters."""
+    return "".join("_" if ch.isspace() or not ch.isprintable() else ch for ch in str(value))
+
+
+def log_charge(invoice_id, amount, card_number, email) -> str:
+    """Log line for a card charge, with the card number and email masked.
+
+    The full card number and email address never reach the log: the card is reduced
+    to its last four digits and the email to its first character plus domain.
+    """
+    return log_line(
+        "charge",
+        invoice=_clean(invoice_id),
+        amount=fmt(amount),
+        card=_mask_card(card_number),
+        email=_mask_email(email),
+    )
diff --git a/tests/test_log_charge.py b/tests/test_log_charge.py
