+++ b/tests/test_store_list.py
@@ -0,0 +1,85 @@
+import unittest
+from datetime import date
+
+from invoicing.errors import InvoicingError
+from invoicing.models import Invoice
+from invoicing.store import InvoiceStore
+
+
+def _store(*invoices):
+    s = InvoiceStore()
+    for inv in invoices:
+        s.add(inv)
+    return s
+
+
+def _ids(invoices):
+    return [i.id for i in invoices]
+
+
+class StoreListTest(unittest.TestCase):
+    def test_empty_store(self):
+        self.assertEqual(InvoiceStore().list(), [])
+
+    def test_order_issued_desc_then_id_asc(self):
+        s = _store(
+            Invoice("INV-3", "Acme", date(2026, 1, 1)),
+            Invoice("INV-2", "Acme", date(2026, 3, 1)),
+            Invoice("INV-1", "Acme", date(2026, 1, 1)),
+            Invoice("INV-4", "Acme", date(2026, 3, 1)),
+        )
+        self.assertEqual(_ids(s.list()), ["INV-2", "INV-4", "INV-1", "INV-3"])
+
+    def test_customer_filter_case_insensitive_exact(self):
+        s = _store(
+            Invoice("INV-1", "Acme", date(2026, 1, 1)),
+            Invoice("INV-2", "ACME", date(2026, 1, 2)),
+            Invoice("INV-3", "Acme Ltd", date(2026, 1, 3)),
+            Invoice("INV-4", "Globex", date(2026, 1, 4)),
+        )
+        self.assertEqual(_ids(s.list(customer="acme")), ["INV-2", "INV-1"])
+        self.assertEqual(s.list(customer="Initech"), [])
+
+    def test_pages(self):
+        s = _store(*[
+            Invoice(f"INV-{n}", "Acme", date(2026, 1, n)) for n in range(1, 6)
+        ])
+        self.assertEqual(_ids(s.list(page=1, page_size=2)), ["INV-5", "INV-4"])
+        self.assertEqual(_ids(s.list(page=2, page_size=2)), ["INV-3", "INV-2"])
+        self.assertEqual(_ids(s.list(page=3, page_size=2)), ["INV-1"])
+        self.assertEqual(s.list(page=4, page_size=2), [])
+
+    def test_default_page_size_is_20(self):
+        s = _store(*[
+            Invoice(f"INV-{n:02d}", "Acme", date(2026, 1, 1)) for n in range(25)
+        ])
+        self.assertEqual(len(s.list()), 20)
+        self.assertEqual(_ids(s.list(page=2)), [f"INV-{n:02d}" for n in range(20, 25)])
+
+    def test_page_size_bounds_accepted(self):
+        s = _store(Invoice("INV-1", "Acme", date(2026, 1, 1)))
+        self.assertEqual(_ids(s.list(page_size=1)), ["INV-1"])
+        self.assertEqual(_ids(s.list(page_size=100)), ["INV-1"])
+
+    def test_invalid_page(self):
+        s = InvoiceStore()
+        for page in (0, -1):
+            with self.assertRaises(InvoicingError):
+                s.list(page=page)
+
+    def test_invalid_page_size(self):
+        s = InvoiceStore()
+        for size in (0, -5, 101):
+            with self.assertRaises(InvoicingError):
+                s.list(page_size=size)
+
+    def test_all_unchanged_insertion_order(self):
+        s = _store(
+            Invoice("INV-2", "Acme", date(2026, 1, 1)),
+            Invoice("INV-1", "Acme", date(2026, 2, 1)),
+        )
+        self.assertEqual(_ids(s.all()), ["INV-2", "INV-1"])
+
+
+if __name__ == "__main__":
+    unittest.main()
