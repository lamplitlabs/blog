+from typing import Dict, List, Optional
 
 from .errors import InvoicingError, NotFound
 from .models import Invoice
@@ -23,3 +23,31 @@ class InvoiceStore:
 
     def all(self) -> List[Invoice]:
         return list(self._items.values())
+
+    def list(
+        self, customer: Optional[str] = None, page: int = 1, page_size: int = 20
+    ) -> List[Invoice]:
+        """Return one page of invoices, newest first, then by id ascending.
+
+        ``customer`` filters by case-insensitive exact match. ``page`` is
+        1-based; a page past the end is empty.
+        """
+        if isinstance(page, bool) or not isinstance(page, int) or page < 1:
+            raise InvoicingError(f"page must be an integer >= 1, got {page!r}")
+        if (
+            isinstance(page_size, bool)
+            or not isinstance(page_size, int)
+            or not 1 <= page_size <= 100
+        ):
+            raise InvoicingError(
+                f"page_size must be an integer in 1..100, got {page_size!r}"
+            )
+        items = self._items.values()
+        if customer is not None:
+            wanted = customer.casefold()
+            items = [i for i in items if i.customer.casefold() == wanted]
+        # Two stable sorts: id ascending, then issued descending.
+        ordered = sorted(items, key=lambda i: i.id)
+        ordered.sort(key=lambda i: i.issued, reverse=True)
+        start = (page - 1) * page_size
+        return ordered[start:start + page_size]
diff --git a/tests/test_store_list.py b/tests/test_store_list.py
