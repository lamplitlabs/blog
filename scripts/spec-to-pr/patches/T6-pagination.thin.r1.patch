+from typing import Dict, List, Optional
 
 from .errors import InvoicingError, NotFound
 from .models import Invoice
@@ -23,3 +24,22 @@ class InvoiceStore:
 
     def all(self) -> List[Invoice]:
         return list(self._items.values())
+
+    def list(
+        self, customer: Optional[str] = None, page: int = 1, page_size: int = 20
+    ) -> List[Invoice]:
+        """Return one page of invoices, optionally only those of ``customer``.
+
+        Invoices come in insertion order (the same order as ``all()``).
+        ``page`` is 1-based; a page past the end is an empty list.
+        """
+        for name, value in (("page", page), ("page_size", page_size)):
+            if isinstance(value, bool) or not isinstance(value, int) or value < 1:
+                raise InvoicingError(f"{name} must be a positive integer, got {value!r}")
+        start = (page - 1) * page_size
+        matching = (
+            inv
+            for inv in self._items.values()
+            if customer is None or inv.customer == customer
+        )
+        return list(islice(matching, start, start + page_size))
diff --git a/tests/test_store_list.py b/tests/test_store_list.py
